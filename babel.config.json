{
    "targets": {
        "edge": "18",
        "firefox": "78",
        "chrome": "74",
        "safari": "13"
    },
    "presets": [
        "@babel/preset-env"
    ],
    "plugins": [
        "@babel/plugin-transform-runtime",
        [
            "babel-plugin-polyfill-corejs3",
            {
                "method": "usage-global",
                "version": "3.50"
            }
        ]
    ]
}
